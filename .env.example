# Copy to .env and fill in. Everything works without a key (extractive answers).
# LLM_PROVIDER = auto | anthropic | openai | none
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Comma-separated origins allowed to call the API (production: your frontend URL)
CORS_ORIGINS=*
# For a separately hosted frontend, set at build time:
# VITE_API_URL=https://your-api.example.com
